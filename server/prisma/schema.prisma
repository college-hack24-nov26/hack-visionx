// Food Waste Saver - database schema.
// Prisma reads this file and creates/updates the PostgreSQL tables to match.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  USER
  NGO
  ADMIN
}

enum ActiveRole {
  CLAIMER
  PROVIDER
  NGO
  ADMIN
}

enum ListingCategory {
  COOKED_MEALS
  RAW_PRODUCE
  BAKERY
  DAIRY
  PACKAGED_FOOD
  BEVERAGES
  OTHER
}

enum DietaryType {
  VEG
  NON_VEG
  VEGAN
}

enum PortionType {
  INDIVIDUAL_MEALS
  BULK_SERVINGS
  KILOGRAMS
  LITRES
  PACKETS
}

enum ListingStatus {
  DRAFT
  LIVE
  PARTIALLY_CLAIMED
  FULLY_CLAIMED
  EXPIRED
  CANCELLED
  REMOVED
}

// Every registered person is a row in this table.
model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  mobile       String      @unique
  passwordHash String
  accountType  AccountType @default(USER)
  activeRole   ActiveRole  @default(CLAIMER)
  orgName      String?
  orgRegNo     String?
  orgAddress   String?
  isSuspended  Boolean     @default(false)
  isMainAdmin  Boolean     @default(false)
  sessions     Session[]
  listings     Listing[]
  claims       Claim[]
  notifications Notification[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// One row per logged-in session. Only the HASH of the refresh token
// is stored, never the token itself.
model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

// One row per surplus-food posting. Drafts may be incomplete;
// the publish endpoint enforces the full rules (FR-L1/L3).
model Listing {
  id              String          @id @default(cuid())
  providerId      String
  provider        User            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  claims          Claim[]
  foodName        String          @default("")
  details         String          @default("")
  category        ListingCategory?
  categoryNote    String?
  dietaryType     DietaryType?
  portionType     PortionType?
  portionCount    Int?
  portionsRemaining Int?
  bulkUnit        String?
  photoUrl        String?
  pickupLocation  String          @default("")
  deadline        DateTime?
  contactPhone    String          @default("")
  showContact     Boolean         @default(false)
  safetyChecklist String[]        @default([])
  deadlineAlertsSent String[]     @default([])
  status          ListingStatus   @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}


enum ClaimStatus {
  CONFIRMED
  COLLECTED
  CANCELLED
  CANCELLED_LATE
  CANCELLED_BY_PROVIDER
  EXPIRED
}

// One row per claim of portions from a listing. The pickup code is
// stored only as a salted hash plus an encrypted re-view copy that
// is erased when the claim reaches a terminal state (FR-C3).
model Claim {
  id                String      @id @default(cuid())
  listingId         String
  listing           Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  claimerId         String
  claimer           User        @relation(fields: [claimerId], references: [id], onDelete: Cascade)
  portions          Int
  status            ClaimStatus @default(CONFIRMED)
  codeHash          String
  codeSalt          String
  codeEncrypted     String?
  verifyAttempts    Int         @default(0)
  verifyLockedUntil DateTime?
  onWayAt           DateTime?
  collectedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}


enum NotificationType {
  LISTING_PUBLISHED
  CLAIM_PLACED
  CLAIMER_ON_THE_WAY
  CLAIM_CANCELLED
  LISTING_CANCELLED
  NEAR_DEADLINE
  CLAIM_COLLECTED
  CLAIM_EXPIRED
}

// One row per in-app notification for one user (FR-NT1).
model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  body             String           @default("")
  relatedListingId String?
  relatedClaimId   String?
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now())
}
