// Food Waste Saver - database schema.
// Prisma reads this file and creates/updates the PostgreSQL tables to match.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every registered person is a row in this table.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  mobile       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
